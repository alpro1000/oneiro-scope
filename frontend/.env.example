# Runtime configuration for the Next.js frontend.
# Local dev: copy to `.env.local`. Production: set these in the Vercel
# project (Settings → Environment Variables). See docs/deploy/vercel-frontend.md.
#
# The frontend is hosted on Vercel; the backend + Postgres + Redis stay on
# Render. Every *_API_URL below points to the BACKEND's public Render URL
# (its RENDER_EXTERNAL_URL, e.g. https://oneiroscope-backend.onrender.com).

# --- Public (baked into the browser bundle at build time) ---
# Development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LUNAR_API_URL=

# --- Server-side (SSR/route handlers only; not exposed to the browser) ---
ASTROLOGY_API_URL=http://localhost:8000
DREAMS_API_URL=http://localhost:8000
LUNAR_API_URL=http://localhost:8000
AUTH_API_URL=http://localhost:8000
BILLING_API_URL=http://localhost:8000

# Default timezone used when the client does not send `tz`.
LUNAR_DEFAULT_TZ=Europe/Moscow

# Hosts (host[:port], NO scheme, comma-separated) allowed to invoke Server
# Actions in production. On Vercel set to your deployment domain, e.g.
# oneiroscope.vercel.app  — localhost:3000 is always allowed automatically.
SERVER_ACTION_ORIGINS=

# Production builds set this to "production" (Vercel does it automatically).
NODE_ENV=development
